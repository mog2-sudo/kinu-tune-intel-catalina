# Run directly with cmake -DCASE=<case> -P tests/MacOSCompatibilityTests.cmake.
set(CMAKE_SYSTEM_NAME Darwin)
if(CASE STREQUAL "invalid-coreml")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=invalid-coreml-child
        -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "bundled Core ML vocoder requires macOS 13")
        message(FATAL_ERROR "Expected Core ML compatibility rejection, got: ${output}${error}")
    endif()
    message(STATUS "MacOSCompatibilityTests invalid-coreml passed")
    return()
endif()
if(CASE STREQUAL "catalina")
    set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "")
    set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15 CACHE STRING "")
elseif(CASE STREQUAL "invalid-coreml-child")
    set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "")
    set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15 CACHE STRING "")
    set(PITCHNET_USE_COREML ON CACHE BOOL "")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/MacOSCompatibility.cmake")
if(CASE STREQUAL "catalina")
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "10.15" OR
       NOT CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64" OR PITCHNET_USE_COREML)
        message(FATAL_ERROR "Catalina must retain x86_64 / 10.15 and use CPU inference")
    endif()
elseif(CASE STREQUAL "default")
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "13.0" OR
       NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64;x86_64" OR NOT PITCHNET_USE_COREML)
        message(FATAL_ERROR "The existing macOS defaults changed")
    endif()
elseif(CASE STREQUAL "invalid-coreml-child")
    message(FATAL_ERROR "Core ML was incorrectly accepted for Catalina")
else()
    message(FATAL_ERROR "Unknown CASE: ${CASE}")
endif()
message(STATUS "MacOSCompatibilityTests ${CASE} passed")
