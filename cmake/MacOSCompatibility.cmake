# Keep the release defaults, while allowing Intel builds for macOS Catalina.
set(CMAKE_OSX_DEPLOYMENT_TARGET "13.0" CACHE STRING "Minimum macOS deployment target")
set(PITCHNET_DEFAULT_USE_COREML OFF)
if(CMAKE_HOST_APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    if(NOT CMAKE_OSX_ARCHITECTURES)
        set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64" CACHE STRING "macOS target architectures")
    endif()
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "13.0")
        set(PITCHNET_DEFAULT_USE_COREML ON)
    endif()
endif()
option(PITCHNET_USE_COREML "Use the macOS 13+ Core ML vocoder instead of ONNX CPU inference" ${PITCHNET_DEFAULT_USE_COREML})
if(PITCHNET_USE_COREML AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "13.0")
    message(FATAL_ERROR "The bundled Core ML vocoder requires macOS 13.0 or later; use -DPITCHNET_USE_COREML=OFF for Catalina.")
endif()
